def key_to_id(key):
    return "0x7000000" + keycodes[key][0]


AGENT_LABEL = "com.emilmair.keywi"
AGENT_PATH = os.path.expanduser("~/Library/LaunchAgents/" + AGENT_LABEL + ".plist")

def load_mappings():
    try:
        with open(AGENT_PATH, "rb") as f:
            config = plistlib.load(f)
            return json.loads(config["ProgramArguments"][-1]).get("UserKeyMapping", [])
    except FileNotFoundError:
        return []

def apply_mappings(mappings):
    hid_json = json.dumps({"UserKeyMapping": mappings}, separators=(",", ":"))
    config = {"Label": AGENT_LABEL, "ProgramArguments": ["/usr/bin/hidutil", "property", "--set", hid_json], "RunAtLoad": True}
    os.makedirs(os.path.dirname(AGENT_PATH), exist_ok=True)
    with open(AGENT_PATH, "wb") as f:
        plistlib.dump(config, f)
    subprocess.run(["/usr/bin/hidutil", "property", "--set", hid_json], check=True)

def service_command(action):
    domain = "gui/" + str(os.getuid())
    target = domain + "/" + AGENT_LABEL
    if action == "start":
        if not os.path.isfile(AGENT_PATH):
            # Create a valid, empty LaunchAgent before bootstrapping.
            apply_mappings([])
        result = subprocess.run(["/bin/launchctl", "bootstrap", domain, AGENT_PATH])
        if result.returncode != 0:
            # A loaded service is already running; verify instead of treating it as an error.
            check = subprocess.run(["/bin/launchctl", "print", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if check.returncode != 0:
                raise SystemExit(result.returncode)
    elif action == "stop":
        result = subprocess.run(["/bin/launchctl", "bootout", target])
        if result.returncode != 0:
            check = subprocess.run(["/bin/launchctl", "print", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if check.returncode == 0:
                raise SystemExit(result.returncode)
    else:
        check = subprocess.run(["/bin/launchctl", "print", target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("running" if check.returncode == 0 else "stopped")

def add_mapping(source_key, destination_key):
    src, dst = int(key_to_id(source_key), 16), int(key_to_id(destination_key), 16)
    mappings = [m for m in load_mappings() if int(m["HIDKeyboardModifierMappingSrc"]) != src]
    mappings.append({"HIDKeyboardModifierMappingSrc": src, "HIDKeyboardModifierMappingDst": dst})
    apply_mappings(mappings)


args = sys.argv[1:]
if len(args) == 0 or args[0] in ("help", "-h", "--help"):
    print("""Keywi - macOS keyboard remapping

Usage:
  keywi set <source_key> <destination_key>  Add or replace a mapping
  keywi get                                 List saved mappings
  keywi clear                              Remove all mappings
  keywi start                              Start the Keywi LaunchAgent
  keywi stop                               Stop the Keywi LaunchAgent
  keywi status                             Show whether the service is running
  keywi help, -h, --help                   Show this help

Keys use names such as caps_lock, left_command, a, return, or f1.
""")
elif args[0] == "clear":
    apply_mappings([])
elif args[0] == "get":
    for mapping in load_mappings():
        print(mapping)
elif args[0] in ("start", "stop", "status"):
    service_command(args[0])
elif args[0] == "set":
    if len(args) != 3:
        print("Error in Syntax: keywi set <source_key> <destination_key>")
    elif args[1] not in keycodes:
        match = difflib.get_close_matches(args[1], keycodes.keys(), n=1)
        if len(match) > 0:
            print(f"Unknown keycode '{args[1]}'. Did you mean '{match[0]}'?")
        else:
            print(f"Unknown keycode '{args[1]}'.")
    elif args[2] not in keycodes:
        match = difflib.get_close_matches(args[2], keycodes.keys(), n=1)
        if len(match) > 0:
            print(f"Unknown keycode '{args[2]}'. Did you mean '{match[0]}'?")
        else:
            print(f"Unknown keycode '{args[2]}'.")
    else:
        add_mapping(args[1], args[2])
